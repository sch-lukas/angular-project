@startuml Buchhandlung_SPA_Zustandsdiagramm
!theme vibrant
skinparam backgroundColor #F8F9FA
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #6B7280
  FontSize 11
}
skinparam ArrowColor #374151
skinparam ArrowThickness 1.5
skinparam Padding 6
skinparam RoundCorner 8

title Buchhandlung SPA - Vollständiges Zustandsdiagramm\n(Stand: Januar 2026)

' ============================================================================
' LAYOUT: Links-nach-Rechts Flow
' ============================================================================
left to right direction

[*] --> Init

' ----------------------------------------------------------------------------
' INITIALISIERUNG
' ----------------------------------------------------------------------------
state "Initialisierung" as Init #E0F2FE {
  [*] --> ThemeCheck : Start
  ThemeCheck : System-Präferenz
  ThemeCheck --> AuthCheck
  AuthCheck : Token vorhanden?
  AuthCheck --> [*]
}

Init --> Nav

' ----------------------------------------------------------------------------
' NAVIGATION (Zentrale Weiche)
' ----------------------------------------------------------------------------
state "Navigation" as Nav #F3F4F6 {
  state "Routen" as Routes
  Routes : /home | /search
  Routes : /books/:id | /cart
  Routes : /wishlist | /login
  Routes : /create (geschützt)
}

' ----------------------------------------------------------------------------
' ÖFFENTLICHE SEITEN
' ----------------------------------------------------------------------------
state "Öffentliche Seiten" as Public #ECFDF5 {

  state "🏠 Startseite" as Home {
    [*] --> Stats
    Stats : Statistiken laden
    Stats --> Carousels
    Carousels : Neu | Beliebt | Günstig
    Carousels --> [*]
  }

  state "🔍 Suche" as Search {
    [*] --> Form
    Form : Filter eingeben
    Form --> Query
    Query : GraphQL
    Query --> Results
    Results : Pagination
    Results --> [*]
  }

  state "📖 Buchdetail" as Detail {
    [*] --> Load
    Load : GraphQL getById
    Load --> Display
    Display : Cover | Info | Autor
    Display --> Actions
    Actions : Warenkorb | Merken
    Actions --> [*]
  }
}

' ----------------------------------------------------------------------------
' STATE MANAGEMENT
' ----------------------------------------------------------------------------
state "State Management" as State #F5F3FF {

  state "🛒 CartService" as CartSvc {
    [*] --> CheckItem
    CheckItem --> SaveCart
    SaveCart : localStorage
    SaveCart --> Notify
    Notify : BehaviorSubject
    Notify --> [*]
  }

  state "❤️ WishService" as WishSvc {
    [*] --> Toggle
    Toggle --> SaveWish
    SaveWish : localStorage
    SaveWish --> NotifyWish
    NotifyWish : BehaviorSubject
    NotifyWish --> [*]
  }
}

' ----------------------------------------------------------------------------
' BENUTZER-VIEWS
' ----------------------------------------------------------------------------
state "Benutzer-Views" as Views #FDF2F8 {

  state "🛒 Warenkorb" as Cart {
    [*] --> LoadCart
    LoadCart : localStorage
    LoadCart --> ShowItems
    ShowItems : Tabelle/Cards
    ShowItems --> CalcTotal
    CalcTotal : Gesamtpreis
    CalcTotal --> [*]
  }

  state "❤️ Merkliste" as Wish {
    [*] --> LoadWish
    LoadWish : localStorage
    LoadWish --> Grid
    Grid : Responsive Grid
    Grid --> [*]
  }
}

' ----------------------------------------------------------------------------
' AUTHENTIFIZIERUNG
' ----------------------------------------------------------------------------
state "Authentifizierung" as Auth #FEF9C3 {

  state "🔐 Login" as Login {
    [*] --> LoginForm
    LoginForm : Credentials
    LoginForm --> Keycloak
    Keycloak : OAuth2 Token
    Keycloak --> StoreToken
    StoreToken : localStorage
    StoreToken --> [*]
  }

  state "🛡️ AuthGuard" as Guard {
    [*] --> CheckToken
    CheckToken : Token gültig?
    CheckToken --> Allow : ✓
    CheckToken --> Deny : ✗
    Allow --> [*]
    Deny --> Login
  }
}

' ----------------------------------------------------------------------------
' GESCHÜTZTER BEREICH
' ----------------------------------------------------------------------------
state "Geschützt" as Protected #FEE2E2 {

  state "➕ Neues Buch" as Create {
    [*] --> GenISBN
    GenISBN : Auto ISBN-13
    GenISBN --> BookForm
    BookForm : Formular
    BookForm --> Validate
    Validate : Prüfung
    Validate --> Mutation : ✓
    Validate --> ErrorPopup : ✗
    ErrorPopup --> BookForm
    Mutation : GraphQL
    Mutation --> Success : 201
    Mutation --> ErrorPopup : 4xx
    Success : Popup + Redirect
    Success --> [*]
  }
}

' ----------------------------------------------------------------------------
' THEME
' ----------------------------------------------------------------------------
state "🌓 Theme" as Theme #E5E7EB {
  [*] --> ToggleTheme
  ToggleTheme : Dark ↔ Light
  ToggleTheme --> UpdateCSS
  UpdateCSS : CSS Variables
  UpdateCSS --> [*]
}

' ============================================================================
' VERBINDUNGEN
' ============================================================================

' Navigation
Nav --> Home
Nav --> Search
Nav --> Detail
Nav --> Cart
Nav --> Wish
Nav --> Login
Nav --> Guard
Nav --> Theme

' Öffentliche Flows
Home --> Search
Home --> Detail
Search --> Detail

' Detail zu Services
Detail --> CartSvc
Detail --> WishSvc

' Services zu Views
CartSvc --> Cart
WishSvc --> Wish

' Views zu Detail
Cart --> Detail
Wish --> Detail

' Auth-Flow
Guard --> Protected

' Nach Erstellung
Protected --> Search

' ============================================================================
' NOTIZEN (kompakt)
' ============================================================================

note bottom of Home
  Statistiken
  3 Carousels
end note

note bottom of Detail
  Cover, Beschreibung
  Ähnliche Bücher
end note

note bottom of CartSvc
  Reaktiver State
  Persistenz
end note

note bottom of Login
  Keycloak OAuth2
  Bearer Token
end note

note bottom of Create
  ISBN Generator
  Validierung
  Popups
end note

@enduml
