# ============================================
# Umgebungsvariablen für das Buch-Projekt
# ============================================
# Diese Datei nach ".env" im Projekt-Root kopieren:
#   Copy-Item "setup-vorlagen/.env.example" ".env"
# ============================================

# --- Datenbank (PostgreSQL) ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=p
DB_DATABASE=buch
DB_SCHEMA=buch

# --- Keycloak (Authentifizierung) ---
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8843
KEYCLOAK_CLIENT_ID=buch-client
KEYCLOAK_CLIENT_SECRET=

# --- Server ---
NODE_ENV=development
HTTPS=true
PORT=3000

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=./log

# --- Mail (optional - kann leer bleiben für Entwicklung) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
